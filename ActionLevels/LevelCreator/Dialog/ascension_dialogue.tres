[gd_resource type="Resource" load_steps=2 format=2]

[ext_resource path="res://addons/dialogue_manager/dialogue_resource.gd" type="Script" id=1]

[resource]
script = ExtResource( 1 )
resource_version = 29
syntax_version = 2
raw_text = "~ you_did_it
Angel: You did it! [wait=1]You completed all the special challenges this game has to offer. [wait=1]
do emit_change_character_portrait(\"AngelHappy\")
Angel: I hereby declare you a \\n[wave]R E A L  G A M E R [/wave]! [wait=2]

~ true_completionist
Angel: A true completionist! [wait=1]You finished everything. [wait=1]
do emit_change_character_portrait(\"AngelHappy\")
Angel: Congratulations! [wait=2]

~ proud
Angel: I am seriously proud of you![wait=1] You played the game so well! [wait=2]

~ wow
Angel: Wow! You really are the best! [wait=2]

~ good_job
Angel: Good job![wait=2]

~ dotdot

do emit_change_character_portrait(\"AngelNeutral\")
Angel: ...[wait=2]

~ this_is_it
Angel: So... this is it. This is all our little world has to offer. [wait=0.5]For now. [wait=1]
do emit_change_character_portrait(\"AngelIntense\")
Angel: I wonder.. was it difficult? Or, more importantly, was it fun? [wait=1]
Angel: I wonder what you expected would happen in the end. [wait=2]

~ doesnt_matter
Angel: But I guess it doesn't matter. We are both here, [wait=0.5]right now. 
do emit_change_character_portrait(\"AngelHappy\")
Angel: Just enjoy the moment for however long you'd like. [wait=1.5]

~ video_games
Angel: Video games are hard to make, y'know? [wait=0.5]A lot harder than people think, [wait=0.5]even with modern tools! [wait=1.5]
Angel: We had so many ideas... So many visions for this game. [wait=1]
Angel: This is what it turned into. [wait=1]A mere fraction of what we imagined. [wait=1.5]
do emit_change_character_portrait(\"AngelHappy\")
Angel: Yet the satisfaction of watching it come to life makes it all worth it! [wait=2]

~ greatest_honor
Angel: And when players explore every nook and cranny of a game.. [wait=1]
Angel: ..that's the greatest honor for a game developer! [wait=1.5]
Angel: So, from the bottom of my heart... [wait=1]
Angel: My angel-heart.. [wait=1]
do emit_change_character_portrait(\"AngelHappy\")
Angel: Thank you so much for playing! [wait=2]

~ thanks

do emit_change_character_portrait(\"AngelHappy\")
Angel: Thank you so much! [wait=2]

~ thanksss
Angel: ...
do emit_change_character_portrait(\"AngelHappy\")
Angel: Thanks again! [wait=2]

~ are_you_still_here
Angel: Are you still here? [wait=1]Hmm...
do emit_change_character_portrait(\"AngelScared\") 
Angel: I can't really think of much else to say. [wait=1.5]
do emit_change_character_portrait(\"AngelIntense\")
Angel: I guess I can just wish you a good day? [wait=1]
do emit_change_character_portrait(\"AngelHappy\")
Angel: I hope you have a good day! [wait=2]

~ dotdotdot
do emit_change_character_portrait(\"AngelNeutral\")
Angel: ... [wait=2]

~ for_real
Angel: For real, I don't think there's gonna be any more interesting dialogue after this. [wait=1.5]
do emit_change_character_portrait(\"AngelHappy\")
Angel: Feel free to leave. [wait=2]

~ for_real2
Angel: It's not a bit. [wait=1]
Angel: There's no secret easter egg to be found by staying here longer. [wait=1.5]
Angel: I promise! [wait=2]

~ ok_fine
Angel: Ok, fine! [wait=1]
do emit_change_character_portrait(\"AngelIntense\")
Angel: Here, have an easter egg. [wait=1]But don't tell anyone, ok? [wait=2]

~ for_real3
Angel: That was seriously the last thing. We can't keep extending it forever. [wait=1]
do emit_change_character_portrait(\"AngelNeutral\")
Angel: It's only a demo after all! [wait=1.5]
Angel: ...So, goodbye![wait=1]
do emit_change_character_portrait(\"AngelHappy\")
Angel: [wave]Thanks for playing~![/wave][wait=3]

~ finish
Angel: Goodbye <3 [wait=2]"
errors = [  ]
