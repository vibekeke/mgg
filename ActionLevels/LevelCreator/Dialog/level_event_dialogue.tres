[gd_resource type="Resource" load_steps=2 format=2]

[ext_resource path="res://addons/dialogue_manager/dialogue_resource.gd" type="Script" id=1]

[resource]
script = ExtResource( 1 )
resource_version = 73
syntax_version = 2
raw_text = "~ level1_intro
Angel: Welcome, brave Magical Girl!
Angel: There is a lot of [shake rate=7 level=15]EVIL[/shake] things going on in this forest... so thank goodness you're here!
Angel: Make sure to take a good look at the controls before you start. [wait=1.5]
Angel: You ready? Let's go [wave]save the day![/wave]


~ level1_event1

Angel: Bees? Un-BEE-leivable [wait=1.5]
% Angel: You're doing great, by the way! [wait=1.5]
% Angel: I wonder what happened to the creatures here... [wait=1.5]
% Angel: It's a great day for defeating enemies! [wait=1.5]
% Angel: By the way, have you ever been to IKEA? [wait=1.5]
% Angel: Here they come! [wait=1.5]
% Angel: Such splendid gold ores! [wait=1.5]
% Angel: ...Do you watch anime? [wait=1.5]
% Angel: Wow, nicely done! [wait=1.5]
% Angel: At least it's not raining... Can you imagine fighting evil in the rain? [wait=1.5]
% Angel: And [shake]SNAKES[/shake] too!? [wait=1.5]
% Angel: So... how's the weather in your world? [wait=1.5]
% Angel: You like jazz, right? [wait=1.5]
% Angel: You should watch Eva! It's about angels, you know. [wait=1.5]
% Angel: ...I like your dress, by the way! [wait=1.5]
% Angel: Just being real with you, that dress is kinda not your style... Just kidding! [wait=1.5] ..Or am I? [wait=1.5]
% Angel: ...Get it? Un-BEE-lieve? [wait=1]

if fun_value < 1 and not first_run
	% Angel: ...You know, it would be nice if you replied every once in a while.[wait=1.5]
	%2 Angel: ...
	% Angel: ...Hey, do you sometimes randomly disassociate from your life and personality to the point where  you're looking at everything you know and love as if it's not even real? [wait=1.5]


~ level1_event2

~ level1_event_boss
Big Bird of Darkness: [speed=0.2] I AM THE [shake rate=7 level=15]DARKNESS[/shake]. 
Big Bird of Darkness: [speed=0.2] I AM THE [shake rate=7 level=15]NIGHT[/shake].

~ level1_event_end
Angel: You did it! You defeated the Bird of Darkness and saved the forest!
Angel: ...But what was that weird thing on top of that bird?"
