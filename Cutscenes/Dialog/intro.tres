raw_text = "~ intro
[color=black][shake]???: [speed=0.5][color=black][shake]Have the bird and fish been deployed?
[color=black][shake]???: [speed=0.5][color=black][shake]Yes sir, the girl should be awakening soon.
[color=black][shake]???: [speed=0.5][color=black][shake]What about the boy?
[color=black][shake]???: [speed=0.5][color=black][shake]That will take more time. But once he awakens the girl will have a [wave]real challenge.[/wave]
[color=black][shake]???: [speed=0.5][color=black][shake]Perfect...
[color=black][shake]???: [speed=0.5][color=black][shake]Finally...
[color=black][shake]???: [speed=0.5][color=black][shake]A world where Moonlight Miko will be real!"
