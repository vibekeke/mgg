raw_text = "~ intro
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=12]Have the bird and fish been deployed?
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=8]Yes sir, the girl should be awakening soon.
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=12]What about the boy?
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=8]That will take more time. But once he awakens the girl will have a [wave]real challenge.[/wave]
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=12]Perfect...
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=12]Finally...
[color=black][shake level=7]???: [speed=0.5][color=black][shake level=12]A world where Moonlight Miko will be real!"
